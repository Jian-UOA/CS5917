%% High contrast initialization (Mermaid 10+)
%%{init: {
  "theme":"base",
  "themeVariables":{
    "fontFamily":"Arial,Helvetica,sans-serif",
    "primaryColor":"#FFFFFF",
    "primaryTextColor":"#000000",
    "primaryBorderColor":"#000000",
    "secondaryColor":"#FFFFFF",
    "secondaryTextColor":"#000000",
    "tertiaryColor":"#FFFFFF",
    "tertiaryTextColor":"#000000",
    "lineColor":"#000000"
  }
}}%%

graph TB
    subgraph "硬件层"
        ZEDCam[ZED立体相机]
        TelloDrone[DJI Tello无人机]
        TB3Robot[TurtleBot3机器人]
        Microphone[麦克风]
        Speaker[扬声器]
    end
    
    subgraph "数据采集层"
        ImageConvert[图像格式转换节点]
        ImageCompress[图像压缩节点]
        StereoSync[立体同步节点]
    end
    
    subgraph "感知与定位层"
        VO[Visual Odometry<br/>视觉里程计]
        SLAM[RTAB-Map SLAM]
        Localization[RTAB-Map定位]
    end
    
    subgraph "导航规划层"
        MapServer[地图服务器]
        Planner[路径规划器]
        Controller[控制器]
        BehaviorTree[行为树导航]
    end
    
    subgraph "应用逻辑层"
        PositionListener[位置监听器]
        AutoDelivery[自动投递节点]
        VoiceControl[语音控制]
    end
    
    subgraph "通信层"
        Topics[ROS2话题]
        Services[ROS2服务]
        TF[坐标变换]
    end
    
    %% 连接关系
    ZEDCam --> ImageConvert --> ImageCompress --> StereoSync
    StereoSync --> VO
    StereoSync --> SLAM
    StereoSync --> Localization
    VO --> SLAM --> MapServer --> Planner --> Controller --> BehaviorTree --> TB3Robot
    Localization --> PositionListener --> AutoDelivery --> TelloDrone
    VoiceControl --> AutoDelivery
    Microphone --> VoiceControl --> Speaker
    
    %% 高对比度样式 (深色背景 + 白字，或黑边 + 适度饱和)
    classDef hardwareClass fill:#0D47A1,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef dataClass fill:#1B5E20,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef perceptionClass fill:#4A148C,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef navClass fill:#E65100,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef appClass fill:#B71C1C,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef commClass fill:#424242,stroke:#000000,stroke-width:2px,color:#FFFFFF
    
    class ZEDCam,TelloDrone,TB3Robot,Microphone,Speaker hardwareClass
    class ImageConvert,ImageCompress,StereoSync dataClass
    class VO,SLAM,Localization perceptionClass
    class MapServer,Planner,Controller,BehaviorTree navClass
    class PositionListener,AutoDelivery,VoiceControl appClass
    class Topics,Services,TF commClass