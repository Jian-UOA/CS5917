%% Copy into a .mmd file and Preview (Mermaid 10+ recommended)
%% High contrast init
%%{init: {
  "theme":"base",
  "themeVariables":{
    "fontFamily":"Arial,Helvetica,sans-serif",
    "primaryColor":"#FFFFFF",
    "primaryTextColor":"#000000",
    "primaryBorderColor":"#000000",
    "secondaryColor":"#FFFFFF",
    "secondaryTextColor":"#000000",
    "tertiaryColor":"#FFFFFF",
    "tertiaryTextColor":"#000000",
    "lineColor":"#000000"
  }
}}%%

graph LR
    %% ========== CLUSTERS / NODES ==========
    subgraph ZED_HW[ZED 相机]
        ZED[ZED<br/>Camera]
    end

    subgraph UOA[uoa_robot_drone 机载计算]
        direction TB
        subgraph ORIN[orin]
            ORIN_NODE["/uoa/cs5917/left/image_rect_color/compressed<br/>/uoa/cs5917/right/image_rect_color/compressed"]
        end
        subgraph PC[pc]
            PC_NODE["/uoa/cs5917/left/image_rect_color<br/>/uoa/cs5917/right/image_rect_color"]
        end
    end

    subgraph NAV2[navigation2]
        NAV2_CORE[navigation2<br/>stack]
    end

    subgraph MAPDB[地图 / 数据]
        MAP[map]
        DB[(database<br/>rtabmap.db)]
    end

    subgraph VIZ[可视化]
        RVIZ[rviz2]
        RTABMAP_VIZ[rtabmap_viz]
    end

    RTABMAP[rtabmap]
    AUTO_DELIVERY["/uoa/auto_delivery"]
    LOCAL_POSE["/localization_pose"]
    VO_ODOM["/vo/odom"]
    TB3_CMD["/tb3/cmd_vel"]
    MAP_TOPIC["/map"]

    subgraph TB3_HW[TurtleBot3 Waffle Pi]
        TB3_BASE[TurtleBot3<br/>Base]
    end

    subgraph TELLO_HW[Tello 无人机]
        TELLO[Tello Drone]
    end

    TF_NODE[TF]

    %% ========== FLOWS ==========
    %% Camera infos
    ZED -->|/zed/zed_node/left/camera_info| RTABMAP
    ZED -->|/zed/zed_node/right/camera_info| RTABMAP

    %% Rectified images (raw)
    ZED -->|"/uoa/left/image_rect_color(bgr8)"| PC_NODE
    ZED -->|"/uoa/right/image_rect_color(bgr8)"| PC_NODE

    %% Compressed path (orin -> pc or reverse)
    ORIN_NODE -->|解压| PC_NODE

    %% SLAM inputs
    PC_NODE -->|图像流| RTABMAP

    %% Odometry + pose
    RTABMAP --> VO_ODOM
    VO_ODOM --> RTABMAP_VIZ
    VO_ODOM --> NAV2_CORE
    RTABMAP --> LOCAL_POSE
    LOCAL_POSE --> NAV2_CORE

    %% Map generation / usage
    RTABMAP --> MAP
    MAP --> MAP_TOPIC
    MAP_TOPIC --> NAV2_CORE
    MAP --> DB
    DB --> RTABMAP

    %% Visualization
    RTABMAP_VIZ --> RVIZ
    MAP --> RVIZ
    LOCAL_POSE --> RVIZ
    VO_ODOM --> RVIZ

    %% Navigation -> robot
    NAV2_CORE --> TB3_CMD --> TB3_BASE

    %% Delivery integration
    AUTO_DELIVERY --> TELLO
    AUTO_DELIVERY --> NAV2_CORE
    NAV2_CORE -->|触发/状态| AUTO_DELIVERY

    %% TF
    TF_NODE --> ZED
    TF_NODE --> TB3_BASE
    TF_NODE --> RTABMAP
    TF_NODE --> NAV2_CORE
    TF_NODE --> RVIZ

    %% Map feedback loop (outline)
    NAV2_CORE -->|执行| TB3_BASE
    TB3_BASE -->|"里程计(经/vo/odom)"| VO_ODOM

    %% ========== STYLES ==========
    classDef hw fill:#0D47A1,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef comp fill:#1B5E20,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef slam fill:#4A148C,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef nav fill:#E65100,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef data fill:#424242,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef viz fill:#1565C0,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef topic fill:#FFFFFF,stroke:#000000,stroke-width:2px,color:#000000
    classDef app fill:#B71C1C,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef tf fill:#880E4F,stroke:#000000,stroke-width:2px,color:#FFFFFF

    class ZED,TELLO,TB3_BASE hw
    class ORIN,PC comp
    class RTABMAP slam
    class NAV2,NAV2_CORE nav
    class DB,MAP data
    class RTABMAP_VIZ,RVIZ viz
    class VO_ODOM,LOCAL_POSE,TB3_CMD,MAP_TOPIC topic
    class AUTO_DELIVERY app
    class TF_NODE tf

    %% (Optional) color arrows (Mermaid may vary by renderer)
    linkStyle default stroke:#000000,stroke-width:1.3px
    %% Example specific link coloring:
    linkStyle 0,1 stroke:#1976D2,stroke-width:1.3px
    linkStyle 9,10 stroke:#D32F2F,stroke-width:1.4px
    linkStyle 13,14 stroke:#2E7D32,stroke-width:1.3px
    linkStyle 19,20,21 stroke:#E65100,stroke-width:1.4px