graph TB
    subgraph "定位阶段 - Localization Mode"
        subgraph "数据输入"
            ZED2[ZED相机]
            LeftImg2[左相机图像]
            RightImg2[右相机图像]
            ExistingMap[已有地图<br/>rtabmap.db]
        end
        subgraph "定位处理"
            StereoSync2[stereo_sync<br/>立体同步]
            StereoOdom2[stereo_odometry<br/>视觉里程计]
            RTABMAPLoc[rtabmap<br/>定位节点]
        end
        subgraph "位置输出"
            GlobalPose[全局位置<br/>/rtabmap/localization_pose]
            LocalOdom[局部里程计<br/>/vo/odom]
            TFTree[TF坐标树<br/>map->odom->base_link]
        end
        subgraph "应用层"
            PosListener[robot_position_listener<br/>位置监听器]
            DeliverySignal[投递信号<br/>/uoa/delivery_signal]
        end
        ZED2 --> LeftImg2
        ZED2 --> RightImg2
        LeftImg2 --> StereoSync2
        RightImg2 --> StereoSync2
        ExistingMap --> RTABMAPLoc
        StereoSync2 --> StereoOdom2
        StereoSync2 --> RTABMAPLoc
        StereoOdom2 --> RTABMAPLoc
        RTABMAPLoc --> GlobalPose
        StereoOdom2 --> LocalOdom
        RTABMAPLoc --> TFTree
        GlobalPose --> PosListener
        TFTree --> PosListener
        PosListener --> DeliverySignal
    end

    subgraph "定位参数"
        DetectionRate2["DetectionRate: 5.0<br/>(低检测率)"]
        MemoryMode2["IncrementalMemory: False<br/>(定位模式)"]
        InitMemory["InitWMWithAllNodes: True<br/>(加载完整地图)"]
    end
    DetectionRate2 -.-> RTABMAPLoc
    MemoryMode2 -.-> RTABMAPLoc
    InitMemory -.-> RTABMAPLoc

    %% High contrast styles
    classDef inputClass fill:#0D47A1,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef processClass fill:#1B5E20,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef outputClass fill:#4A148C,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef appClass fill:#B71C1C,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef paramClass fill:#E65100,stroke:#000000,stroke-width:2px,color:#FFFFFF

    class ZED2,LeftImg2,RightImg2,ExistingMap inputClass
    class StereoSync2,StereoOdom2,RTABMAPLoc processClass
    class GlobalPose,LocalOdom,TFTree outputClass
    class PosListener,DeliverySignal appClass
    class DetectionRate2,MemoryMode2,InitMemory paramClass