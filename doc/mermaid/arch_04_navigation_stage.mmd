graph TB
    subgraph "导航阶段 - Navigation Mode"
        subgraph "地图服务"
            MapServer[map_server<br/>地图服务器]
            StaticMap[静态地图<br/>uoa_robot_drone_vslam_*.yaml]
        end
        subgraph "路径规划"
            PlannerServer[planner_server<br/>全局路径规划]
            GlobalPlanner[A*算法<br/>全局路径]
        end
        subgraph "运动控制"
            ControllerServer[controller_server<br/>局部控制器]
            LocalPlanner[DWB局部规划器]
            CmdVel[速度命令<br/>/tb3/cmd_vel]
        end
        subgraph "行为管理"
            BTNavigator[bt_navigator<br/>行为树导航器]
            BehaviorServer[behavior_server<br/>恢复行为]
            WaypointFollower[waypoint_follower<br/>航点跟随]
        end
        subgraph "状态管理"
            LifecycleManager[lifecycle_manager<br/>生命周期管理器]
            NodeStates[节点状态管理<br/>启动/停止/重置]
        end
        subgraph "机器人平台"
            TB3Node[turtlebot3_node<br/>机器人控制节点]
            DynamixelSDK[Dynamixel SDK<br/>电机控制]
            TB3Hardware[TurtleBot3硬件]
        end

        StaticMap --> MapServer --> PlannerServer --> GlobalPlanner --> BTNavigator
        BTNavigator --> ControllerServer --> LocalPlanner --> CmdVel --> TB3Node --> DynamixelSDK --> TB3Hardware
        BTNavigator --> BehaviorServer
        BTNavigator --> WaypointFollower
        LifecycleManager --> MapServer
        LifecycleManager --> PlannerServer
        LifecycleManager --> ControllerServer
        LifecycleManager --> BTNavigator
        LifecycleManager --> BehaviorServer
        LifecycleManager --> NodeStates
        TB3Hardware -.->|里程计反馈| TB3Node
        TB3Node -.->|/odom| ControllerServer
        ControllerServer -.->|执行状态| BTNavigator
        BehaviorServer -.->|恢复状态| BTNavigator
    end

    %% High contrast styles
    classDef mapClass fill:#0D47A1,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef planClass fill:#1B5E20,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef controlClass fill:#4A148C,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef behaviorClass fill:#B71C1C,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef manageClass fill:#E65100,stroke:#000000,stroke-width:2px,color:#FFFFFF
    classDef robotClass fill:#424242,stroke:#000000,stroke-width:2px,color:#FFFFFF

    class MapServer,StaticMap mapClass
    class PlannerServer,GlobalPlanner planClass
    class ControllerServer,LocalPlanner,CmdVel controlClass
    class BTNavigator,BehaviorServer,WaypointFollower behaviorClass
    class LifecycleManager,NodeStates manageClass
    class TB3Node,DynamixelSDK,TB3Hardware robotClass