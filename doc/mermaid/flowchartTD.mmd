    classDef flowClass fill:#fff9c4,stroke:#f57f17,stroke-width:3px,color:#000000
    classDef inputClass fill:#e1f5fe,stroke:#0277bd,stroke-width:3px,color:#000000
    
    class AutoDelivery,RobotListener,TB3Node,RTABMap,TelloSDK,VoiceModule,GoalPoseService,DynamixelSDK,OpenCR,StereoCamera,Odometry nodeClass
    class Tello,TurtleBot,Camera,Microphone,Speaker hardwareClass
    class Topics,Services,Parameters commClass
    class Flow1,Flow2,Flow3,Flow4,Flow5 flowClass
